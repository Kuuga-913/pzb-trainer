<Window x:Class="PBZTrainer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PBZTrainer"
        xmlns:m="clr-namespace:PBZTrainer.Models"
        Title="影之刃零 修改器"
        Width="1200" Height="820" MinWidth="900" MinHeight="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <DataTemplate x:Key="CardTemplate" DataType="{x:Type m:FeatureVm}">
            <Border x:Name="CardRoot"
                    BorderThickness="1" CornerRadius="9" Margin="6" Padding="15,12"
                    SnapsToDevicePixels="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Card}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#4A3B52"/>
                                <Setter Property="Background" Value="#1B181F"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.ToolTip>
                    <StackPanel MaxWidth="340">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                   Foreground="#B9AEBB" FontSize="11.5"/>
                        <TextBlock Text="{Binding Id}" Foreground="#6E6673" FontSize="10.5" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border.ToolTip>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                        <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Visibility="{Binding IsEnabled, Converter={StaticResource Vis}}"/>
                        <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <ToggleButton Grid.Row="0" Grid.Column="1" Style="{StaticResource Switch}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  Visibility="{Binding HasToggle, Converter={StaticResource Vis}}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{Binding Description}" Style="{StaticResource Sub}"
                               TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis"
                               Margin="0,5,0,0" Visibility="{Binding Description, Converter={StaticResource TextVis}}"/>

                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,9,0,0"
                                VerticalAlignment="Center">
                        <TextBox Style="{StaticResource ValueBox}" Width="88" Height="28"
                                 Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding HasValue, Converter={StaticResource Vis}}"
                                 KeyDown="ValueBox_KeyDown" LostFocus="ValueBox_LostFocus"/>
                        <Button Content="−" Style="{StaticResource Ghost}" Width="24" Height="28"
                                Padding="0" Margin="5,0,0,0" FontSize="13" Click="StepDown_Click"
                                Visibility="{Binding HasValue, Converter={StaticResource Vis}}"/>
                        <Button Content="+" Style="{StaticResource Ghost}" Width="24" Height="28"
                                Padding="0" Margin="4,0,0,0" FontSize="12" Click="StepUp_Click"
                                Visibility="{Binding HasValue, Converter={StaticResource Vis}}"/>

                        <Button Content="{Binding ActionText}" Style="{StaticResource Ghost}"
                                Height="28" Margin="8,0,0,0" FontSize="11.5" Padding="10,0"
                                Click="Action_Click"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StateText}"
                               Style="{StaticResource Sub}" VerticalAlignment="Center"
                               Margin="10,9,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Shell" Margin="16" CornerRadius="12" BorderThickness="1"
            BorderBrush="#241F2A">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B0B0E" Offset="0"/>
                <GradientStop Color="#141018" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 水墨背景字 -->
            <TextBlock Text="刃" FontFamily="{StaticResource BrushFont}" FontSize="132"
                       Foreground="#FFFFFF" Opacity="0.055" IsHitTestVisible="False"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-26,232,0"/>

            <!-- 顶栏 -->
            <Grid Grid.Row="0" Margin="22,16,14,12" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8"
                        Background="{DynamicResource Accent}" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.5" Color="#C0392B"/>
                    </Border.Effect>
                    <TextBlock Text="影" FontFamily="{StaticResource BrushFont}" FontSize="26"
                               Foreground="#FFF6F2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="影之刃零" FontFamily="{StaticResource BrushFont}" FontSize="25"
                                   Foreground="#F3EDE6"/>
                        <Rectangle Width="1" Height="17" Fill="{DynamicResource Gold}" Margin="12,4,12,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="修改器" FontSize="13" Foreground="#A79CA8" VerticalAlignment="Center"
                                   Margin="0,2,0,0"/>
                        <Border Background="#1E1B23" CornerRadius="4" Padding="6,2" Margin="10,2,0,0"
                                BorderThickness="1" BorderBrush="{DynamicResource Border}">
                            <TextBlock x:Name="CountBadge" Text="76 项" FontSize="10.5"
                                       Foreground="{DynamicResource Jade}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="SubtitleText" Text="水墨江湖 · 全功能训练器"
                               Style="{StaticResource Sub}" Margin="1,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StatusPill" Background="#1B181F" CornerRadius="15" Padding="12,6"
                            BorderThickness="1" BorderBrush="{DynamicResource Border}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#6E6673"
                                     VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="StatusText" Text="未连接" FontSize="12"
                                       Foreground="#8C8390" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="ConnectButton" Content="连接游戏" Style="{StaticResource AccentBtn}"
                            Margin="10,0,0,0" Height="30" Click="Connect_Click"/>

                    <Button Content="置顶" Style="{StaticResource IconBtn}" Width="40" Margin="6,0,0,0"
                            Click="Pin_Click" x:Name="PinButton"/>
                    <Button Content="—" Style="{StaticResource IconBtn}" Click="Min_Click" Margin="2,0,0,0"/>
                    <Button Content="✕" Style="{StaticResource IconBtn}" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- 分隔线 -->
            <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource Border}" Margin="22,0,22,0"/>

            <!-- 主体：左侧分组导航 + 右侧内容 -->
            <Grid Grid.Row="2" Margin="16,10,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="196"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#0F0E12" CornerRadius="10"
                        BorderThickness="1" BorderBrush="{DynamicResource Border}" Margin="6,0,10,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="NavPanel" Margin="6,10,6,12"/>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="6,0,6,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="PageHead" VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitle" Text="基础功能" FontSize="18" FontWeight="Bold"/>
                            <TextBlock x:Name="PageSubtitle" Text="常用能力与资源控制" Style="{StaticResource Sub}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <Grid x:Name="SearchHost" Grid.Column="1" Width="240" VerticalAlignment="Center">
                            <TextBox x:Name="SearchBox" Style="{StaticResource ValueBox}" Height="28"
                                     TextChanged="Search_TextChanged" Padding="26,3,8,3"/>
                            <TextBlock Text="🔍" FontSize="11" Foreground="#6E6673" Margin="9,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock x:Name="SearchHint" Text="搜索功能（Ctrl + F）" Style="{StaticResource Sub}"
                                       Margin="26,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>

                    <ScrollViewer x:Name="ChipHost" Grid.Row="1" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled" Margin="6,0,6,2">
                        <StackPanel x:Name="ChipPanel" Orientation="Horizontal"/>
                    </ScrollViewer>

                    <Grid Grid.Row="2">
                        <Grid x:Name="FeatureHost">
                            <ScrollViewer x:Name="CardScroll" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                                <StackPanel x:Name="FeatureSections"/>
                            </ScrollViewer>

                            <TextBlock x:Name="EmptyHint" Text="没有匹配的功能，试试其他关键词"
                                       Style="{StaticResource Sub}" HorizontalAlignment="Center"
                                       VerticalAlignment="Top" Margin="0,60,0,0" Visibility="Collapsed"/>
                        </Grid>
                        <ContentControl x:Name="PageHost" Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- 底栏 -->
            <Grid Grid.Row="3" Margin="22,10,22,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="{DynamicResource Gold}" VerticalAlignment="Center"
                             Margin="0,0,7,0"/>
                    <TextBlock x:Name="FooterInfo" Text="等待游戏连接" Style="{StaticResource Sub}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="PanelKeyHint" Text="F1 显隐" Style="{StaticResource Sub}" Margin="0,0,14,0"/>
                    <TextBlock Text="Ctrl+F 搜索 · 拖标题移动窗口" Style="{StaticResource Sub}" Margin="0,0,14,0"/>
                    <TextBlock x:Name="SaveHint" Text="状态已自动保存" Style="{StaticResource Sub}"/>
                </StackPanel>
            </Grid>

            <!-- 提示条 -->
            <Border x:Name="Toast" Grid.Row="0" Grid.RowSpan="4" VerticalAlignment="Bottom"
                    HorizontalAlignment="Center" Margin="0,0,0,58" CornerRadius="8"
                    Background="#E61E1B23" BorderThickness="1" BorderBrush="{DynamicResource Border}"
                    Padding="16,9" Opacity="0" IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" Text="" FontSize="12" Foreground="#EDE7E0"/>
            </Border>

            <!-- 快捷键录入遮罩 -->
            <Border x:Name="HotkeyLayer" Grid.Row="0" Grid.RowSpan="4" Background="#CC0B0B0E"
                    Visibility="Collapsed">
                <Border Background="#17151B" CornerRadius="10" BorderThickness="1"
                        BorderBrush="{DynamicResource Border}" Padding="26,22" Width="360"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="HotkeyTitle" Text="设置快捷键" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="HotkeyHint" Text="请按下要绑定的按键，Esc 取消，Backspace 清除"
                                   Style="{StaticResource Sub}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <Border Background="{DynamicResource Chip}" CornerRadius="8" Margin="0,16,0,0"
                                Padding="0,14" BorderThickness="1" BorderBrush="{DynamicResource Border}">
                            <TextBlock x:Name="HotkeyPreview" Text="等待按键…" FontSize="20"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource Jade}"
                                       FontFamily="{StaticResource BrushFont}"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
