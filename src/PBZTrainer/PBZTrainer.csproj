<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PBZTrainer</AssemblyName>
    <RootNamespace>PBZTrainer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <Version>1.0.0</Version>
    <Product>影之刃零修改器</Product>
    <Company>初五助手</Company>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\PBZFeatures.json" />
    <EmbeddedResource Include="Data\PBZCatalog.json" Condition="Exists('Data\PBZCatalog.json')" />
  </ItemGroup>

</Project>
